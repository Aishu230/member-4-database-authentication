PORT=5000
NODE_ENV=development

# MongoDB connection string
# If MongoDB is not running locally, it gracefully falls back to the in-memory database
MONGO_URI=mongodb://127.0.0.1:27017/saas_collab_db

# JWT Configuration (Never commit your real secret to Git)
JWT_SECRET=replace_this_with_a_long_random_secret_key_for_jwt
JWT_EXPIRES_IN=7d

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Set to false if you want the server to fail when MongoDB is unavailable
ALLOW_MEMORY_DB=true

# Rate Limiting (per 15 minutes window)
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=30
